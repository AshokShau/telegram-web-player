FROM golang:1.27-alpine3.23 AS builder

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go generate ./...
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o tgweb .

FROM alpine:3.23

WORKDIR /app

RUN apk add --no-cache ca-certificates libstdc++ ffmpeg

COPY --from=builder /app/tgweb ./
COPY --from=builder /app/libtdjson.so.* ./

CMD ["./tgweb"]
